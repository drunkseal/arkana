import "../assets/DepartureMono-Regular.otf";
import { GameView, GameViewData } from "game_view.slint";
import { SlideView } from "slide_view.slint";
import { SettingsView } from "settings_view.slint";

export struct SettingData {
    setting-id: int,
    title: string,
    // 0 = command entry, 1 = volume bar, 2 = brightness bar.
    kind: int,
}

export component MainWindow inherits Window {
    title: "Arkana";
    background: black;
    width: 640px;
    height: 480px;

    default-font-family: "Departure Mono";
    default-font-size: 33px;

    in-out property <[GameViewData]> game-data-array;
    in-out property <[SettingData]> settings-data-array;

    in-out property <bool> show-settings: false;
    in-out property <int> battery-level;

    callback settings-run-command(int);
    in-out property <string> settings-command-output;

    in-out property <string> terminal-output;
    in-out property <bool> terminal-active;
    in-out property <int> terminal-id;
    callback terminal-key(string);
    callback terminal-exit();

    callback current-game-changed(int);
    callback launch-game(int);
    callback play-navigation-sound();

    property <int> game-current-index: game-slideview.current-item - 1;
    changed game-current-index => {
        root.current-game-changed(game-current-index);
    }

    changed show-settings => {
        if (show-settings) {
            settings-slideview.grab-focus();
        } else {
            game-slideview.grab-focus();
        }
        root.play-navigation-sound();
    }

    init => {
        game-slideview.grab-focus();
    }

    main-handler := FocusScope {
        width: parent.width;
        height: parent.height;
        focus-on-click: false;

        key-pressed(event) => {
            if (event.text == Key.Space) {
                show-settings = !show-settings;
                accept
            } else if (event.text == Key.Return && !show-settings) {
                root.launch-game(game-current-index);
                accept
            } else {
                reject
            }
        }

        game-slideview := SlideView {
            width: parent.width;
            height: parent.height;
            list-size: game-data-array.length;
            background: show-settings ? beige : black;

            navigate() => { root.play-navigation-sound(); }

            for i in [1, 2, 3]: GameView {
                property <int> index: i;

                background: black;
                data: game-data-array.length > 0
                    ? game-data-array[parent.item-for-view(index) - 1]
                    : {
                        game_id: 0,
                        title: "",
                        initial: "",
                        cover_art: @image-url(""),
                        has-cover: false,
                        c1: #000000,
                        c2: #000000
                    };

                is_active: parent.position-offset(index) == 0 && !show-settings;

                width: parent.width;
                height: parent.height;

                x: parent.position-offset(index) * parent.width;

                animate x {
                    duration:
                        (index != parent.last-view-index
                         && index != parent.current-view-index)
                            ? 0ms
                            : 250ms;

                    easing: ease-in-out;
                }
            }
        }

        settings-slideview := SlideView {
            width: parent.width;
            height: parent.height;

            list-size: settings-data-array.length;

            navigate() => { root.play-navigation-sound(); }

            x: parent.x;
            y: show-settings ? parent.y : +parent.height;

            animate y {
                duration: 250ms;
                easing: ease-in-out;
            }

            for i in [1, 2, 3]: SettingsView {
                property <int> index: i;

                is_active:
                    index == parent.current-view-index
                    && show-settings;

                background: beige;

                title: settings-data-array.length > 0
                    ? settings-data-array[parent.item-for-view(index) - 1].title
                    : "";

                command-id: settings-data-array.length > 0
                    ? settings-data-array[parent.item-for-view(index) - 1].setting-id
                    : 0;

                view-kind: settings-data-array.length > 0
                    ? settings-data-array[parent.item-for-view(index) - 1].kind
                    : 0;

                run-command(id) => {
                    root.settings-run-command(id);
                }

                command-output: settings-command-output;

                terminal-active: root.terminal-active;
                terminal-id: root.terminal-id;
                terminal-output: root.terminal-output;
                terminal-key(text) => { root.terminal-key(text); }
                terminal-exit() => { root.terminal-exit(); }

                width: parent.width;
                height: parent.height;

                x: parent.position-offset(index) * parent.width;

                animate x {
                    duration:
                        (index != parent.last-view-index
                         && index != parent.current-view-index)
                            ? 0ms
                            : 250ms;

                    easing: ease-in-out;
                }
            }
        }
    }

    battery-indicator := Text {
        text: battery-level + "%";

        x: parent.width - self.width - 10px;
        y: 10px;

        color: beige;
        visible: !show-settings;

        font-size: 22px;
    }
}
