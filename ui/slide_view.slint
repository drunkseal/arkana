export component SlideView inherits Rectangle {
    clip: true;

    property <bool> is-active: key-handler.has-focus;

    in property <int> list-size;
    in-out property <int> current-item: 1; // 1-based
    out property <int> current-view-index;
    out property <int> last-view-index;

    // Fired after the selection moves to another item.
    callback navigate();

    // The item currently displayed by each of the three visual slots.
    out property <int> view-item-1;
    out property <int> view-item-2;
    out property <int> view-item-3;

    public pure function position-offset(v: int) -> int {
        return Math.mod(
            Math.mod(v - current-view-index + 1, 3) + 3,
            3
        ) - 1;
    }

    // Wrap a 1-based item index into 1..list-size.
    public pure function wrap-item(v: int) -> int {
        return Math.mod(
            Math.mod(v - 1, list-size) + list-size,
            list-size
        ) + 1;
    }

    // Return the item currently assigned to a visual slot.
    public pure function item-for-view(v: int) -> int {
        if (v == 1) {
            return view-item-1;
        } else if (v == 2) {
            return view-item-2;
        } else {
            return view-item-3;
        }
    }

    function set-view-item(v: int, item: int) {
        if (v == 1) {
            view-item-1 = item;
        } else if (v == 2) {
            view-item-2 = item;
        } else {
            view-item-3 = item;
        }
    }

    function update-index() {
        last-view-index = current-view-index;
        current-view-index = Math.mod(current-item - 1, 3) + 1;
    }

    function refresh-arrangement() {
        if (list-size <= 0) {
            return;
        }

        last-view-index = current-view-index;
        current-view-index = Math.mod(current-item - 1, 3) + 1;

        view-item-1 = wrap-item(current-item);
        view-item-2 = wrap-item(current-item + 1);
        view-item-3 = wrap-item(current-item - 1);
    }

    public function next-item() {
        if (list-size <= 1) {
            return;
        }

        let new-item = wrap-item(current-item + 1);

        // The slot which is currently on the left and will
        // teleport to the right after this movement.
        let new-view-index = Math.mod(current-view-index, 3) + 1;
        let recycled-view-index = Math.mod(new-view-index, 3) + 1;

        // Put the incoming item into the recycled/off-screen view
        // BEFORE starting the animation.
        set-view-item(
            recycled-view-index,
            wrap-item(new-item + 1)
        );

        current-item = new-item;

        last-view-index = current-view-index;
        current-view-index = new-view-index;

        navigate();
    }

    public function previous-item() {
        if (list-size <= 1) {
            return;
        }

        let new-item = wrap-item(current-item - 1);

        // The slot which will teleport from the right to the left.
        let new-view-index =
            current-view-index == 1
                ? 3
                : current-view-index - 1;

        let recycled-view-index =
            new-view-index == 1
                ? 3
                : new-view-index - 1;

        // Put the incoming item into the recycled/off-screen view
        // BEFORE starting the animation.
        set-view-item(
            recycled-view-index,
            wrap-item(new-item - 1)
        );

        current-item = new-item;

        last-view-index = current-view-index;
        current-view-index = new-view-index;

        navigate();
    }

    public function grab-focus() {
        key-handler.focus();
    }

    key-handler := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-click: false;

        key-pressed(event) => {
            if (event.text == Key.LeftArrow) {
                previous-item();
                accept
            } else if (event.text == Key.RightArrow) {
                next-item();
                accept
            } else {
                reject
            }
        }

        @children
    }

    init => {
        current-view-index = Math.mod(current-item - 1, 3) + 1;
        last-view-index = current-view-index;

        refresh-arrangement();
    }

    // The game model is assigned from Rust after window creation,
    // so list-size starts at 0. Repopulate the slots once data lands.
    changed list-size => {
        refresh-arrangement();
    }
}
